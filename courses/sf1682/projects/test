% a)
% Euler framåt
% y_(i+1) = y_i + h lambda y_i <=> y_(i+1) = (1 + h lambda) y_i
% R(z) = 1 + z
% |R(z)| < 1 <=> Re(z) finns i (-2, 0) 

% Euler bakåt
% y_(i+1) = y_i + h lambda y_(i+1)
% y_(i+1)(1 - h lambda) = y_i <=> y_(i+1) = 1/(1-z) y_i
% R(z) = 1/(1-z)
% |R(z)| < 1 <=> 1/|1-z| < 1 <=> 1 < |1-z| <=> Re(z) finns i RR\(0, 2)

% b) 
% Euler framåt: R(z) = 1+z
% Trapetsmetoden: R(z) = (2+z)/(2-z)

% c)
% Euler framåt: För omega = 1 
% |R(i omega h)| = |R(ih)| = sqrt(1 + h^2), vilket är större än 1 för h>0 => växer alltid.

h_trapets = 0.01;
stabilitet = sqrt(1 + (16*h_trapets^2)/(16*h_trapets^4 - 8*h_trapets^2 + 16));
format long;
disp("Stabilitet för trapetsmetoden: " + stabilitet)
% Trapetsmetoden: för h = 0.01, |R| = 1+ 5e-5 > 1 => växer långsamt.

% d) Stämmer! Euler spiralerar mycket utåt, trapetsmetoden ligger ganska nära banan.

%% U7 a)

varv = 50; 
antal_steg = 1000*varv;
tslut = varv*2*pi;
tees = linspace(t0, tslut, antal_steg + 1);

u0 = [1; 0; 0; 1]; % initiala värden

euler_u = euler(u0, @planetrhs, tees); % värden från euler
trapets_u = trapets(u0, tees, @planetrhs, @jacobi); % värden från trapets
sv_u = stormer_verlet(u0, tees); % värden från störmer-verlet


euler_energi = zeros(length(euler_u), 1); 
trapets_energi = zeros(length(trapets_u), 1);
sv_energi = zeros(length(sv_u), 1);

fel = zeros(3, length(tees));

energi = @(u) (1/2)*(u(3)^2 + u(4)^2) - 1/sqrt(u(1)^2 + u(2)^2);

E0 = energi(u0);

% beräknar delta E för varje
for i = 1:length(tees)
    % Euler
    euler_energi(i) = energi(euler_u(:, i));

    % Trapetsmetoden
    trapets_energi(i) = energi(trapets_u(:, i));

    % Störmer-Verlet
    sv_energi(i) = energi(sv_u(:, i));

    fel(:, i) = [
        euler_energi(i) - E0;
        trapets_energi(i) - E0;
        sv_energi(i) - E0
        ];
end

% plotta avvikelsen från E0 för varje metod
figure()

% euler och de andra 2 är på så olika plottar eftersom eulers fel var så
% mycket större att de andra bara såg ut som funktionen y = 0 på den
% plotten
subplot(2, 1, 1)
hold on;
plot(tees, fel(1, :))
legend("Euler")
title("U7 a: Fel i energi för Euler Framåt")

subplot(2, 1, 2)
plot(tees, fel(2, :))
hold on;
plot(tees, fel(3, :))
legend(["Trapets", "Störmer-Verlet"])
title("U7 a: Fel i energi för Trapetsmetoden och Störmer-Verlet")

%% U7 b)

% den här delen gör samma sak som U7 a), men endast för Störmer-Verlet och
% för jättemånga varv

varv = 5000;
antal_steg = 1000*varv;
tslut = varv*2*pi;
tees = linspace(t0, tslut, antal_steg + 1);

u0 = [1; 0; 0; 1]; % initialvärden

sv_u = stormer_verlet(u0, tees);
sv_energi = zeros(length(sv_u), 1);
sv_fel = zeros(length(sv_u), 1);

for i = 1:length(tees)

    % Störmer-Verlet
    sv_energi(i) = energi(sv_u(:, i));

    sv_fel(i) = sv_energi(i) - E0;
end

% plotta delta E för Störmer-Verlet
figure()
plot(tees, sv_fel);
title("U7 b: Störmer-Verlet fel jättemånga varv")

