%% U5

disp("--------------")
disp("U5")
disp("--------------")

% a)
t0 = 0;
tslut = pi/2;
antal_steg = 10*[2, 4, 8, 16, 32, 64 ,128];
u0 = [1; 0; 0; 1];

fel = zeros(3, length(antal_steg)); % matris som innehåller felen

% loopa över alla olika steglängder
for i=1:length(antal_steg)
    tees = linspace(t0, tslut, antal_steg(i));

    % Kör metoderna för ett kvartsvarv
    exakt_u = exaktLosning(u0, tees);
    euler_u = euler(u0, @planetrhs, tees);
    trapets_u = trapets(u0, tees, @planetrhs, @jacobi);
    stormer_verlet_u = stormer_verlet(u0, tees);

    fel(1, i) = vecnorm(euler_u(:, end) - exakt_u(:, end));
    fel(2, i) = vecnorm(trapets_u(:, end) - exakt_u(:, end));
    fel(3, i) = vecnorm(stormer_verlet_u(:, end) - exakt_u(:, end));
end

% beräkna delta t för varje steglängd
delta_t = (tslut - t0)./antal_steg;

% b och c)

% samla resultaten i en tabell
metoder = ["Euler Framåt", "Trapetsmetoden", "Störmer-Verlet"];
resultat = array2table(fel', "RowNames", string(delta_t), "VariableNames", metoder);
disp("FEL")
disp(resultat)
disp("---------")
disp("")

% beräkna konvergensordningen mellan successiva steglängder
nogrannhetsordningar = log2(fel(:, 1:end-1) ./ fel(:, 2:end));
nogrannhet = array2table(nogrannhetsordningar', "RowNames", string(delta_t(2:end)), "VariableNames", metoder);
disp("NOGRANNHETSORDNINGAR")
disp(nogrannhet)


% log-log plot av felen
figure()
plot(log(delta_t), log(fel(1, :)));
hold on;
plot(log(delta_t), log(fel(2, :)));
plot(log(delta_t), log(fel(3, :)));
legend(metoder)
title("U5: logaritmerat fel mot log(\Delta t) för varje metod")
hold off;

%% U6

disp("--------------")
